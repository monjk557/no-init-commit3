# Development Dockerfile
FROM golang:1.23-alpine

# Install development tools and dependencies
RUN apk add --no-cache \
    git \
    ca-certificates \
    tzdata \
    make \
    bash \
    curl \
    jq

# Install Air for hot reload
RUN go install github.com/cosmtrek/air@latest

# Install golangci-lint for development
RUN curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/master/install.sh | sh -s -- -b $(go env GOPATH)/bin v1.54.2

# Set working directory
WORKDIR /app

# Copy go mod files first for better caching
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code (this will be overridden by volume mount in dev)
COPY . .

# Create directories for development
RUN mkdir -p /repos /config /var/log/collabops

# Set development environment
ENV CGO_ENABLED=0
ENV GOOS=linux
ENV GOARCH=amd64

# Expose port for development
EXPOSE 9090

# Health check for development
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:9090/repos/health || exit 1

# Default command for development (can be overridden)
CMD ["go", "run", "./cmd/git-executor"] 