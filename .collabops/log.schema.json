{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://collabops.ai/schema/log/v1.json",
  "title": "CollabOps 구조화 로그 — 라인 계약 v1",
  "description": "서비스가 stdout 에 내보내는 로그 한 줄(JSON)의 계약. top-level 은 고정 목록이고, 그 밖의 컨텍스트는 metadata 안에 자유롭게 담는다. 값이 없는 필드는 빈 문자열로 채워 **항상 싣는다** — 단 에러 축 2개는 예외(docs/LOG-PROTOCOL.md §3).",
  "type": "object",
  "required": [
    "event",
    "level"
  ],
  "additionalProperties": false,
  "properties": {
    "event": {
      "description": "이 로그가 무슨 사건인지. 항상 값이 있다.",
      "type": "string",
      "minLength": 1
    },
    "level": {
      "description": "심각도. Go 계열의 warn 은 warning 으로 맞춘다(§4).",
      "enum": [
        "debug",
        "info",
        "warning",
        "error",
        "critical"
      ]
    },
    "msg": {
      "description": "사람이 읽는 한 줄. `message` 는 쓰지 않는다.",
      "type": "string"
    },
    "request_id": {
      "description": "요청 상관관계 ID(X-Request-ID). 요청 스코프가 아니면 \"\".",
      "type": "string"
    },
    "trace_id": {
      "description": "OpenTelemetry trace id (32 hex 소문자).",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        {
          "const": "",
          "description": "값 없음 sentinel — 이 필드는 항상 실린다(§3)"
        }
      ]
    },
    "span_id": {
      "description": "OpenTelemetry span id (16 hex 소문자).",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        {
          "const": "",
          "description": "값 없음 sentinel — 이 필드는 항상 실린다(§3)"
        }
      ]
    },
    "method": {
      "description": "HTTP 메서드. 비-HTTP 로그면 \"\".",
      "anyOf": [
        {
          "enum": [
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "OPTIONS",
            "TRACE",
            "CONNECT"
          ]
        },
        {
          "const": "",
          "description": "값 없음 sentinel — 이 필드는 항상 실린다(§3)"
        }
      ]
    },
    "path": {
      "description": "요청 경로. 쿼리스트링 제외(쿼리는 metadata 로).",
      "type": "string"
    },
    "duration_ms": {
      "description": "처리 시간(밀리초).",
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "const": "",
          "description": "값 없음 sentinel — 이 필드는 항상 실린다(§3)"
        }
      ]
    },
    "request_size_bytes": {
      "description": "요청 본문 바이트 수.",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "const": "",
          "description": "값 없음 sentinel — 이 필드는 항상 실린다(§3)"
        }
      ]
    },
    "request_content_type": {
      "description": "요청 Content-Type 헤더.",
      "type": "string"
    },
    "request_body_keys": {
      "description": "요청 본문의 최상위 키 이름 목록. 값은 싣지 않는다.",
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "const": "",
          "description": "값 없음 sentinel — 이 필드는 항상 실린다(§3)"
        }
      ]
    },
    "exc_info": {
      "description": "스택 트레이스 전문. 4xx 같은 예상된 거절에는 싣지 않는다(§5).",
      "type": "string"
    },
    "metadata": {
      "description": "위 목록에 없는 모든 컨텍스트. 키 이름은 강제하지 않는다 — 단 top-level 예약어와 같은 이름은 쓸 수 없다(그 자리로 올려야 한다).",
      "anyOf": [
        {
          "type": "object",
          "propertyNames": {
            "not": {
              "enum": [
                "event",
                "level",
                "msg",
                "error_code",
                "status_code",
                "request_id",
                "trace_id",
                "span_id",
                "method",
                "path",
                "duration_ms",
                "request_size_bytes",
                "request_content_type",
                "request_body_keys",
                "exc_info"
              ]
            }
          }
        },
        {
          "const": "",
          "description": "값 없음 sentinel — 이 필드는 항상 실린다(§3)"
        }
      ]
    },
    "error_code": {
      "description": "머신 판별용 에러 코드. 에러 계약의 error.code 와 같은 값. **값이 있을 때만 싣는다** — 빈 문자열/null 금지(§3 예외).",
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "status_code": {
      "description": "HTTP 응답 코드. **값이 있을 때만 싣는다** — 숫자 필드라 \"\" 를 실으면 `status_code >= 500` 이 깨진다(§3 예외).",
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    }
  },
  "allOf": [
    {
      "$comment": "§5 — 5xx 는 error. type 을 함께 걸어야 문자열 status_code 에 vacuously 매칭되지 않는다.",
      "if": {
        "required": [
          "status_code"
        ],
        "properties": {
          "status_code": {
            "type": "integer",
            "minimum": 500
          }
        }
      },
      "then": {
        "properties": {
          "level": {
            "const": "error"
          }
        }
      }
    },
    {
      "$comment": "§5 — 4xx 는 warning",
      "if": {
        "required": [
          "status_code"
        ],
        "properties": {
          "status_code": {
            "type": "integer",
            "minimum": 400,
            "maximum": 499
          }
        }
      },
      "then": {
        "properties": {
          "level": {
            "const": "warning"
          }
        }
      }
    },
    {
      "$comment": "§5 — 4xx(예상된 거절)에는 스택 트레이스를 싣지 않는다. exc_info 는 항상 실리는 필드라 빈 문자열이어야 한다.",
      "if": {
        "required": [
          "status_code"
        ],
        "properties": {
          "status_code": {
            "type": "integer",
            "minimum": 400,
            "maximum": 499
          }
        }
      },
      "then": {
        "properties": {
          "exc_info": {
            "const": ""
          }
        }
      }
    }
  ],
  "$comment": "빈 문자열은 '값 없음' sentinel 이며 항상 실리는 필드에만 허용된다. 에러 축(error_code·status_code)은 예외로, 값이 있을 때만 싣는다 — status_code 가 숫자 필드여서 \"\" 를 실으면 Loki 숫자 필터가 조용히 무력화되기 때문. 근거는 docs/LOG-PROTOCOL.md §3."
}
