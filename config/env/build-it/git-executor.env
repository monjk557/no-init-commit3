# =============================================================================
# CollabOps Git Executor Configuration
# =============================================================================

# Server Configuration
SERVER_PORT=5001
SERVER_TCP_GIT_PORT=5222
SERVER_BASE_PATH=/
SERVER_HOST_NAME=0.0.0.0

# Git Repository Configuration
GIT_REPO_ROOT=/var/lib/git/repos

# Event Bus Redis — EVENT_BUS_REDIS_* 스키마 (Python 서비스와 통일). build-it Redis 는 무인증.
EVENT_BUS_REDIS_MODE=cluster
EVENT_BUS_REDIS_NODE_ADDRESS=192.168.0.30:6382,192.168.0.30:6383,192.168.0.30:6384
EVENT_BUS_REDIS_SOCKET_TIMEOUT_S=5
EVENT_BUS_REDIS_USERNAME=
EVENT_BUS_REDIS_PASSWORD=