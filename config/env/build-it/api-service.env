# =============================================================================
# CollabOps API Service Configuration (Build Mode)
# =============================================================================

# Application Settings
APP_NAME=CollabOps API Service
DJANGO_SETTINGS_MODULE=config.settings.local
DEBUG=true

# Network & Security Settings
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,collabops-api-service
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Disable HTTPS redirects for development
SECURE_SSL_REDIRECT=false
SECURE_PROXY_SSL_HEADER=
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SECURE_CONTENT_TYPE_NOSNIFF=true
SECURE_BROWSER_XSS_FILTER=true

# Disable Django security middleware that might cause redirects
DISABLE_SECURITY_MIDDLEWARE=true
FORCE_HTTP=true

# Database Configuration
DB_HOST=api-service-db
DB_PORT=5432
DB_NAME=collabops
DB_USER=postgres
DB_PASSWORD=postgres
DB_CONN_MAX_AGE=0
DB_SSLMODE=disable

# Redis Configuration
REDIS_URL=redis://redis-api-service:6379/0
REDIS_HOST=redis-api-service
REDIS_PORT=6379
REDIS_DB=0

# API Configuration
DRF_API_KEY=api_service_key_local_it

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENABLE_JWT_MIDDLEWARE=false

# Feature Flags
USE_SQLITE=0
USE_DUMMY_CACHE=0
CELERY_EAGER=1

# Superuser Configuration
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@collabops.ai
DJANGO_SUPERUSER_PASSWORD=admin123
DJANGO_SUPERUSER_FIRST_NAME=Admin
DJANGO_SUPERUSER_LAST_NAME=User

# Logging
GUNICORN_LOG_LEVEL=info
GUNICORN_WORKERS=2

BASE_URL=http://collabops-local.ai