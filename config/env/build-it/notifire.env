# CollabOps Service Notifier - Environment Variables
# Copy this file to .env and adjust values as needed

# ===== Broker Configuration =====
# Choose one: redis_pubsub, redis_streams, kafka
BROKER=redis_pubsub

# ===== Redis Configuration =====
# Internal Docker network uses port 6379
# External access via localhost:6382

# Standalone mode (single Redis instance)
# REDIS_MODE=standalone
# REDIS_URL=redis://redis-piper:6379

# Cluster mode (multiple Redis nodes)
# REDIS_MODE can be: standalone (default) or cluster
# For cluster, specify multiple nodes separated by commas
REDIS_MODE=cluster
REDIS_URL=redis://redis-piper-1:6379,redis://redis-piper-2:6379,redis://redis-piper-3:6379
REDIS_MAX_CONNECTIONS=50

# ===== Kafka Configuration =====
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_GROUP_ID=collabops-notifier
KAFKA_AUTO_OFFSET_RESET=latest

# ===== Authentication =====
# Disable for local development
AUTH_ENABLED=false

# Enable for production with JWKS
# AUTH_ENABLED=true
# JWT_JWKS_URL=https://auth.collabops.ai/.well-known/jwks.json
# JWT_ALGORITHM=RS256

# ===== WebSocket Configuration =====
WS_HEARTBEAT_INTERVAL=30
WS_MAX_MESSAGE_SIZE=1048576

# ===== Application Settings =====
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8083
HOST=0.0.0.0

NOTIFIER_HOST=http://localhost:3000


# ===== Redis PED DQL Configuration == 
DLQ_AUTO_RETRY_INTERVAL=60
DLQ_RETRY_DELAY_SECONDS=300
DLQ_MAX_RETRY_COUNT=3
DLQ_STREAM_NAME=cicd:dlq
DLQ_BATCH_SIZE=100

PEL_RECOVERY_INTERVAL=60
PEL_RECOVERY_MIN_IDLE_MS=600000
PEL_RECOVERY_MAX_DELIVERY_COUNT=3
PEL_AUTOCLAIM_BATCH_SIZE=100