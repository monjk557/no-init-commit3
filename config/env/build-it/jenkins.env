# =============================================================================
# Jenkins Controller Configuration (local-it)
# =============================================================================

# Jenkins Server Settings
JENKINS_PORT=8080
JENKINS_AGENT_PORT=50000

# Java Options
JAVA_OPTS=-Djenkins.install.runSetupWizard=false -Djava.awt.headless=true -Dfile.encoding=UTF-8 -Dhudson.plugins.git.GitSCM.ALLOW_LOCAL_CHECKOUT=true

# Jenkins Configuration as Code
CASC_JENKINS_CONFIG=/usr/share/jenkins/ref/casc/controller.yaml

# =============================================================================
# Jenkins Runner (Agent) Configuration (local-it)
# =============================================================================

# Jenkins Controller Connection
JENKINS_URL=http://collabops-service-jcontroller:8080
JENKINS_AGENT_NAME=runner-default
JENKINS_SECRET=650047df4d56acff99714ab87b54c4361807371eecd744da7cd98f64e8a3ab5e

# Agent Working Directory
JENKINS_WORKDIR=/home/jenkins