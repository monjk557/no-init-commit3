# App
APP_NAME=Document Platform
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=false
PORT=8084

# Database
DATABASE_URL=postgresql://postgres:apaoUsd4C7EGnMg9BWpy@192.168.0.30:5432/api_docs
