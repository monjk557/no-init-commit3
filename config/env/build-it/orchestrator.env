# =============================================================================
# CollabOps API Orchestrator Service Configuration (Build Mode)
# =============================================================================

# Application Settings
APP_NAME=CollabOps API Orchestrator
ENABLE_RELOAD=true
UVICORN_RELOAD=true

# API Service 연동 인증
DRF_API_KEY=api_service_key

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENABLE_JWT_MIDDLEWARE=false

# URL Configuration - Comprehensive redirect prevention
ORCHESTRATOR_BASE_URL=http://localhost:2345
FRONTEND_BASE_URL=http://localhost:3000
NGINX_BASE_URL=http://localhost:80

# API Path Configuration - NO trailing slashes
API_PREFIX=/api/v1
HEALTH_PATH=/health
METRICS_PATH=/metrics
DOCS_PATH=/docs

# URL Redirect Prevention Settings
DISABLE_FASTAPI_REDIRECTS=true
STRICT_URL_VALIDATION=true
TRAILING_SLASH_POLICY=never
ENABLE_REDIRECT_DETECTION=true
ENABLE_URL_VALIDATION=true

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:3001

# Server Configuration
PORT=2345

# External Service URLs
SERVICE_API_URL=http://collabops-api-service:8000
DRF_BASE_URL=http://collabops-api-service:8000
DRF_TIMEOUT=30
DRF_RETRY_COUNT=3

BASE_URL=http://collabops-local.ai

# API Protocol Configuration
API_SERVICE_PROTOCOL=http
API_SERVICE_HOST=collabops-api-service:8000
API_SERVICE_SSL_VERIFY=false
API_SERVICE_FOLLOW_REDIRECTS=false
API_SERVICE_MAX_REDIRECTS=0

# DRF Endpoint Configuration
DRF_HEALTH_ENDPOINT=/health/
DRF_PING_ENDPOINT=/api/ping/
DRF_USER_PROFILE_ENDPOINT=/user_profile/
DRF_CHANGE_REQUESTS_ENDPOINT=/change-requests/
DRF_ISSUES_ENDPOINT=/issues/
DRF_PROJECTS_ENDPOINT=/projects/
DRF_LABELS_ENDPOINT=/labels/
DRF_ORGANIZATIONS_ENDPOINT=/organizations/
DRF_ECHO_ENDPOINT=/api/echo/

# Orchestrator Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@orchestrator-db:5432/collabops_orchestrator
DB_HOST=orchestrator-db
DB_PORT=5432
DB_NAME=collabops_orchestrator
DB_USER=postgres
DB_PASSWORD=postgres

# Orchestrator Redis Configuration
REDIS_URL=redis://redis-orchestrator:6379/0
REDIS_HOST=redis-orchestrator
REDIS_PORT=6379
REDIS_DB=0
