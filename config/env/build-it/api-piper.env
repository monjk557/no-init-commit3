# =============================================================================
# API Service Piper Configuration (build-it)
# =============================================================================

# Application Settings
APP_ENV=local

# PORT
PIPER_PORT=8001

# URL
CORS_ORIGINS=http://localhost:3000

# SECRET
POSTHOG_API_KEY=phc_XWcGslHQX2kBvFssIu41EWVlmZboGcBowCmCVNiTwJj

# Git Repository
WTM_REPOS_ROOT=/var/lib/git/pipelines
GIT_PIPELINES_PREFIX=/var/lib/git/repos/

# Worktree Manager URL
WORKTREE_MANAGER_URL=http://collabops-service-wtm:8082

# Redis
REDIS_URL=redis://192.168.0.30:6382,redis://192.168.0.30:6383,redis://192.168.0.30:6384

# Database Configuration
# Docker Compose 환경에서는 서비스 이름으로 접근 (piper-db:5432)
# 로컬에서 직접 접근하는 경우: localhost:5434 (포트 매핑)
PIPER_DATABASE_URL=postgresql://postgres:apaoUsd4C7EGnMg9BWpy@192.168.0.30:5432/api_piper

# Encryption
ENCRYPTION_KEY=rZ1g7f7KQ6Z8pQXv2dG3E0mA0y0kXkK5N2XJxF8Qe0Y=
ALLOW_EPHEMERAL_ENCRYPTION_KEY=False

# =============================================================================
# Tekton/Kubernetes Configuration
# =============================================================================
# Kubernetes API Server URL
# kubectl proxy를 사용하는 경우: http://host.docker.internal:8080 (포트 8001은 Docker 컨테이너가 사용 중)
# 직접 접근하는 경우: https://host.docker.internal:6443
KUBERNETES_URL=http://host.docker.internal:8080

# Tekton Namespace
TEKTON_NAMESPACE=default

# Kubernetes SSL Verification
# 로컬 개발 환경에서는 false로 설정 (self-signed certificate 허용)
KUBERNETES_VERIFY_SSL=false