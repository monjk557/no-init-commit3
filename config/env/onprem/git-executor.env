# =============================================================================
# CollabOps Git Executor Configuration — On-Premises (Air-Gap)
# =============================================================================
# onprem = prod 수준의 보안/안정성 + 내부망 제약
# - 외부 인터넷 접근 불가
# - HTTPS 미보장 (HTTP 통신)
# - GCP 서비스 사용 불가 (GCS, Cloud SQL 등)
# =============================================================================

# Environment
APP_ENV=onprem

# Server Configuration (doc-360 §4.7 self-prefix 제거)
PORT=5001
TCP_GIT_PORT=5222
BASE_PATH=/
HOST=0.0.0.0  # 코드 미사용 (host 는 "0.0.0.0" 하드코딩); helm/env 일관성 위해 권장명만

# Git Repository Configuration
GIT_REPO_ROOT=/var/lib/git/repos

# Redis (내부망 Redis 클러스터)
REDIS_URL=redis://redis:6379

# LFS Configuration — 로컬 스토리지 사용 (GCS 사용 불가)
LFS_ENABLED=true
LFS_STORAGE_BACKEND=local
LFS_LOCAL_PATH=/var/lib/git/lfs-objects

# Git Maintenance
GIT_MAINTENANCE_ENABLED=true
