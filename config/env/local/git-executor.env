# =============================================================================
# Git Executor Service Configuration (Local Development)
# =============================================================================
# Simplified environment variable configuration

# =============================================================================
# Required Environment Variables
# =============================================================================
# These environment variables are required for the service to start.

# Server configuration
PORT=5001
TCP_PORT=5222
HOST_NAME=0.0.0.0

# Git repository configuration
GIT_ROOT=/var/lib/git/repos

# =============================================================================
# Optional Environment Variables
# =============================================================================

# Observability - Tracing (when set, automatically enables tracing)
# TRACING_ENDPOINT=http://jaeger:14268

# Observability - Metrics (when set, automatically enables metrics)
# METRICS_ENDPOINT=http://prometheus:9090
# METRICS_PORT=9090

# =============================================================================
# Hardcoded default values (managed in config.go, cannot be overridden)
# =============================================================================
# - server.base_path: /repos
# - server.read_timeout: 30s
# - server.write_timeout: 30s
# - server.idle_timeout: 120s
# - server.shutdown_timeout: 30s
# - server.health_check_path: /health
# - logging.level: info
# - logging.format: json
# - logging.output: stdout

