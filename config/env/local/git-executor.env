# =============================================================================
# CollabOps Git Executor Configuration
# =============================================================================

# Server Configuration
COLLABOPS_SERVER_PORT=5001
COLLABOPS_SERVER_TCP_GIT_PORT=5222
COLLABOPS_SERVER_HOST=0.0.0.0
COLLABOPS_SERVER_BASE_PATH=/
COLLABOPS_SERVER_READ_TIMEOUT=60s
COLLABOPS_SERVER_WRITE_TIMEOUT=60s
COLLABOPS_SERVER_IDLE_TIMEOUT=300s
COLLABOPS_SERVER_ENABLE_DOCS=true
COLLABOPS_SERVER_DOCS_PATH=/api-docs

# Git Repository Configuration
COLLABOPS_GIT_REPO_ROOT=/var/lib/git/repos
COLLABOPS_GIT_ENABLE_PACKFILE=true
COLLABOPS_GIT_MAX_CACHE_SIZE=100
COLLABOPS_GIT_CACHE_TTL=5m

# Logging Configuration
COLLABOPS_LOGGING_LEVEL=info
COLLABOPS_LOGGING_FORMAT=json
COLLABOPS_LOGGING_OUTPUT=stdout
COLLABOPS_LOGGING_DEVELOPMENT=false

# Observability Configuration
COLLABOPS_OBSERVABILITY_TRACING_ENABLED=false
COLLABOPS_OBSERVABILITY_TRACING_ENDPOINT=
COLLABOPS_OBSERVABILITY_TRACING_SERVICE_NAME=collabops-git-executor
COLLABOPS_OBSERVABILITY_TRACING_SERVICE_VERSION=1.0.0
COLLABOPS_OBSERVABILITY_METRICS_ENABLED=false
# COLLABOPS_OBSERVABILITY_METRICS_ENDPOINT=
COLLABOPS_OBSERVABILITY_METRICS_PORT=9090