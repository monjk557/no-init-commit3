# =============================================================================
# CollabOps API Service Configuration
# =============================================================================

# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.local
DEBUG=true

# API Service Database
DB_HOST=api-service-db
DB_PORT=5432
DB_NAME=collabops
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# Redis Configuration
REDIS_URL=redis://redis-api-service:6379/0
REDIS_HOST=redis-api-service
REDIS_PORT=6379
REDIS_DB=0
