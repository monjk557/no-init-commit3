# =============================================================================
# CollabOps API Service Configuration (Local Development)
# =============================================================================
# 바로 사용 가능한 개발용 기본값들
# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.local
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,collabops-api-service,collabops-local.ai

# Security - 개발용 기본값 (프로덕션에서는 변경 필요)
INTERNAL_SERVICE_MODE=true
HTTPS_REQUIRED=false
SECURE_SSL_REDIRECT=false

# API Service Database
API_SERVICE_DB_HOST=api-service-db
API_SERVICE_DB_NAME=collabops
API_SERVICE_DB_USER=postgres
API_SERVICE_DB_PORT=5432
API_SERVICE_DB_PASSWORD=postgres
API_SERVICE_TEST_DB_NAME=test_collabops

# Redis Configuration
API_SERVICE_REDIS_URL=redis://redis-api-service:6379/0

# Redis Configuration
REDIS_URL=redis://redis-api-service:6379
REDIS_HOST=redis-api-service
REDIS_API_SERVICE_PORT=6380
REDIS_PORT=6379
REDIS_DB=0

# Development Features
USE_SQLITE=false
USE_DUMMY_CACHE=false
VERBOSE_LOGS=false
SECRET_KEY=django-insecure-local-development-key-not-for-production

# Superuser Configuration - 개발용 기본값
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123

# Cache Configuration
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=collabops

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://collabops-local.ai
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_ALL_HEADERS=false

# Celery Configuration
CELERY_EAGER=true

# Email Configuration
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@collabops.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
FRONTEND_URL=http://localhost:3000

# Security Configuration
HTTPS_REQUIRED=false
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_BROWSER_XSS_FILTER=true
SECURE_CONTENT_TYPE_NOSNIFF=true

# Gunicorn Configuration
API_SERVICE_PORT=8000
GUNICORN_WORKERS=4
GUNICORN_LOG_LEVEL=info

# Monitoring Configuration
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false

# OpenFGA Configuration - CI/spec generation safe defaults
API_SERVICE_OPENFGA_STORE_ID=ci-placeholder-store-id
OPENFGA_TIMEOUT=30
OPENFGA_ENABLED=true
BASE_URL=http://collabops-local.ai

# Object Storage 설정 (온프레미스 환경)
STORAGE_TYPE=minio

# 저장소 공통 설정
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_PUBLIC_BUCKET_NAME=collabops-public-assets

# Posthug configuration
POSTHOG_API_KEY=phc_XWcGslHQX2kBvFssIu41EWVlmZboGcBowCmCVNiTwJj

# API SERVICE DATABASE 
API_SERVICE_DB=collabops
API_SERVICE_DB_USER=postgres
API_SERVICE_DB_USER_PASSWORD=postgres
API_SERVICE_DB_PORT=5432
API_SERVICE_DB_HOST=api-service-db

# OpenFGA
OPENFGA_URL=http://openfga:8080
API_SERVICE_OPENFGA_STORE_ID=01KAFJ647PPSJ0E6MMEP418E48

# CDN
CDN_ENDPOINT=https://cdn.collabops.ai
CDN_KEY=yKdJUkxHvjVTYjxWXNXeZA==
CDN_KEY_NAME=my-signing-key


# django settings
DJANGO_SETTINGS_MODULE=config.settings.local


EVENT_BUS_REDIS_MODE=cluster
EVENT_BUS_REDIS_NODE_ADDRESS=redis-piper-1:6379,redis-piper-2:6379,redis-piper-3:6379