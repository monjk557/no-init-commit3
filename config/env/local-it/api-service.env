# =============================================================================
# CollabOps Local Integration Test Environment - 공통 설정
# =============================================================================

# Application Environment
APP_ENV=local
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG

# Network Configuration
HOST=0.0.0.0

# Django Security
SECRET_KEY=dev-integration-test-secret-key-for-local-it-environment-12345
INTERNAL_SERVICE_MODE=true
HTTPS_REQUIRED=false
SECURE_SSL_REDIRECT=false

# Docker Compose Port Configuration
ORCHESTRATOR_PORT=2345
API_SERVICE_PORT=8000
WEB_PORT=3000
DB_PORT=5432
ORCHESTRATOR_DB_PORT=5433
REDIS_ORCHESTRATOR_PORT=6379
REDIS_API_SERVICE_PORT=6380

# Database Configuration
DB_NAME=collabops
DB_USER=postgres
DB_PASSWORD=postgres

# Common Feature Flags
ENABLE_METRICS=true
MIGRATION_STRATEGY=auto

# Logging Configuration
GUNICORN_LOG_LEVEL=info
GUNICORN_WORKERS=2
