# =============================================================================
# CollabOps Git Executor Service Configuration
# =============================================================================
# Git Protocol Server 전용 환경변수

# Application Settings
APP_NAME=CollabOps Git Executor
APP_ENV=local
LOG_LEVEL=DEBUG

# Server Configuration
PORT=9091
HOST=0.0.0.0

# Git Repository Configuration
REPOSITORY_ROOT=/app/test-repos
ENABLE_DOCS=true
DOCS_PATH=/api-docs
BASE_PATH=/repos

# Permission Service Integration
PERMISSION_SERVICE_URL=http://collabops-api-service:8000
PERMISSION_SERVICE_TIMEOUT=30
PERMISSION_SERVICE_RETRY_COUNT=3

# Authentication Headers
REQUIRED_HEADERS=X-USER-ID,X-Source
VALID_SOURCES=http-gateway,ssh-gateway,orchestrator

# Performance Configuration
MAX_CONCURRENT_OPERATIONS=10
CACHE_SIZE=100
STREAM_BUFFER_SIZE=32768

# Security Configuration
ENABLE_PATH_VALIDATION=true
ENABLE_RATE_LIMITING=true
MAX_REQUESTS_PER_MINUTE=100

# Logging Configuration
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_METRICS=true
LOG_FORMAT=json
