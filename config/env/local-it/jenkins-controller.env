# =============================================================================
# Jenkins Controller Configuration (local-it)
# =============================================================================

# Jenkins Server Settings
JENKINS_PORT=8080
JENKINS_AGENT_PORT=50000

# Java Options
JAVA_OPTS=-Djenkins.install.runSetupWizard=false -Djava.awt.headless=true -Dfile.encoding=UTF-8

# Jenkins Configuration as Code
CASC_JENKINS_CONFIG=/usr/share/jenkins/ref/casc/controller.yaml
