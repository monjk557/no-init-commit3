# CollabOps Git Executor Configuration
# Copy this file to config.yaml and customize for your environment

# HTTP Server Configuration
server:
  # Port to listen on (default: 8080)
  port: 8080
  
  # Base path for all API endpoints (default: "/repos")
  # All endpoints will be prefixed with this path
  base_path: "/repos"
  
  # Host to bind to (default: "0.0.0.0")
  # Use "localhost" or "127.0.0.1" for local-only access
  host: "0.0.0.0"
  
  # HTTP timeouts
  read_timeout: "30s"   # Maximum time to read request
  write_timeout: "30s"  # Maximum time to write response
  idle_timeout: "120s"  # Maximum time for keep-alive connections

# Git Repository Configuration
git:
  # Root directory where Git repositories are stored (required)
  # This should match the directory structure: {repo_root}/{owner}/{repo}.git
  repo_root: "/var/lib/git/repos"
  
  # Enable Git Smart HTTP protocol packfile operations (default: true)
  # Set to false to disable packfile streaming (may impact performance)
  enable_packfile: true
  
  # Maximum number of repositories to keep in memory cache (default: 100)
  # Increase for better performance with many repositories
  max_cache_size: 100
  
  # Time to keep repositories in cache before eviction (default: "5m")
  # Format: "5m", "1h", "30s", etc.
  cache_ttl: "5m"

# JWT Authentication Configuration
jwt:
  # JWT signing algorithm (required)
  # Supported: "RS256", "HS256", "ES256"
  algorithm: "RS256"
  
  # Path to public key file for RS256/ES256 algorithms
  # Required when using RS256 or ES256
  public_key_path: "/etc/collabops/public.pem"
  
  # Secret key for HS256 algorithm
  # Required when using HS256
  # secret_key: "your-secret-key-here"

# Logging Configuration
log:
  # Log level (default: "info")
  # Options: "debug", "info", "warn", "error", "fatal"
  level: "info"
  
  # Log format (default: "json")
  # Options: "json", "text"
  format: "json"
  
  # Log output destination (default: "stdout")
  # Options: "stdout", "stderr", or file path
  output: "stdout"
  
  # Development mode (default: false)
  # Enables more verbose logging and stack traces
  development: false

# Environment-specific examples:

# Development Configuration Example:
# server:
#   port: 3000
#   host: "localhost"
# git:
#   repo_root: "./test-repos"
#   max_cache_size: 10
# jwt:
#   algorithm: "HS256"
#   secret_key: "dev-secret-key"
# log:
#   level: "debug"
#   format: "text"
#   development: true

# Production Configuration Example:
# server:
#   port: 8080
#   host: "0.0.0.0"
#   read_timeout: "60s"
#   write_timeout: "60s"
#   idle_timeout: "300s"
# git:
#   repo_root: "/var/lib/git/repos"
#   max_cache_size: 500
#   cache_ttl: "10m"
# jwt:
#   algorithm: "RS256"
#   public_key_path: "/etc/collabops/keys/public.pem"
# log:
#   level: "info"
#   format: "json"
#   output: "/var/log/collabops/git-executor.log"

# Environment Variables:
# All configuration values can be overridden using environment variables
# with the prefix "COLLABOPS_" and dot notation replaced with underscores.
# 
# Examples:
#   COLLABOPS_SERVER_PORT=9090
#   COLLABOPS_GIT_REPO_ROOT=/custom/path
#   COLLABOPS_JWT_ALGORITHM=HS256
#   COLLABOPS_LOG_LEVEL=debug 