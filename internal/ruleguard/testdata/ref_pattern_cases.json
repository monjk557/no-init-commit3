      "ref_type": "branch | tag (the pushed ref's derived type)",
      "ref_name": "short ref name",
      "default_branch": "string or null (~DEFAULT_BRANCH resolution)",
      "expected": "bool — ruleset applies to this ref"
    }
  },
  "cases": [
