    { "id": "charclass_miss", "target_type":"tag", "ref_include":["v[0-9]*"], "ref_exclude":[], "ref_type":"tag", "ref_name":"vx", "default_branch":null, "expected": false },
    { "id": "token_all", "target_type":"branch", "ref_include":["~ALL"], "ref_exclude":[], "ref_type":"branch", "ref_name":"a/b/c", "default_branch":null, "expected": true },
    { "id": "star_root_alias_crosses_slash", "target_type":"branch", "ref_include":["*"], "ref_exclude":[], "ref_type":"branch", "ref_name":"a/b/c", "default_branch":null, "expected": true },
    { "id": "default_branch_token_match", "target_type":"branch", "ref_include":["~DEFAULT_BRANCH"], "ref_exclude":[], "ref_type":"branch", "ref_name":"main", "default_branch":"main", "expected": true },
    { "id": "default_branch_token_miss", "target_type":"branch", "ref_include":["~DEFAULT_BRANCH"], "ref_exclude":[], "ref_type":"branch", "ref_name":"dev", "default_branch":"main", "expected": false },
    { "id": "default_branch_token_no_default_failsafe", "target_type":"branch", "ref_include":["~DEFAULT_BRANCH"], "ref_exclude":[], "ref_type":"branch", "ref_name":"main", "default_branch":null, "expected": false },
    { "id": "target_type_mismatch", "target_type":"branch", "ref_include":[], "ref_exclude":[], "ref_type":"tag", "ref_name":"v1", "default_branch":null, "expected": false },
