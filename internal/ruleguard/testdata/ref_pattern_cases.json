    { "id": "segment_star_not_cross_slash", "target_type":"branch", "ref_include":["release/*"], "ref_exclude":[], "ref_type":"branch", "ref_name":"release/a/b", "default_branch":null, "expected": false },
    { "id": "double_star_any_depth", "target_type":"branch", "ref_include":["release/**"], "ref_exclude":[], "ref_type":"branch", "ref_name":"release/a/b", "default_branch":null, "expected": true },
    { "id": "double_star_slash_zero_depth", "target_type":"branch", "ref_include":["releases/**/*"], "ref_exclude":[], "ref_type":"branch", "ref_name":"releases/x", "default_branch":null, "expected": true },
    { "id": "question_one_char", "target_type":"tag", "ref_include":["v?"], "ref_exclude":[], "ref_type":"tag", "ref_name":"v3", "default_branch":null, "expected": true },
