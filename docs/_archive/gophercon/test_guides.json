              "status": "verified"
            },
            {
              "target": "PathExists 체크: s.fsManager.PathExists(existing.Path)",
              "mutation": "if false { ... }",
              "test_result": "KILLED - TestLayer1_PathExistsCheck에서 감지",
              "status": "verified"
            }
          ]
        },
        "workspace/store.go": {
          "mutations_tested": [
            {
              "target": "GetExpired: now.After(workspace.ExpiresAt)",
              "mutation": "now.Before(workspace.ExpiresAt)",
              "test_result": "KILLED - TestGetExpired, TestTTL_GetExpiredReturnsOnlyExpired에서 감지",
              "status": "verified"
            }
          ]
        },
        "eviction/evictor.go": {
          "mutations_tested": [
            {
              "target": "LRU 정렬: LastUsedAt.Before()",
              "mutation": "LastUsedAt.After() (MRU로 변경)",
              "test_result": "KILLED - TestEviction_PriorityOrder에서 감지",
              "status": "verified"
            },
            {
              "target": "RefCount 0 우선순위",
              "mutation": "RefCount 체크 로직 제거",
              "test_result": "KILLED - TestEviction_ZeroRefCountCandidates에서 감지",
              "status": "verified"
            }
          ]
        },
