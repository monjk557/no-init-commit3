                            "path": [
                                "repos",
                                "{{owner}}",
                                "{{repo}}",
                                "files",
                                "hello.txt"
                            ]
                        },
                        "description": "Deletes an existing file from the repository."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('File deleted successfully', function () {",
                                    "  pm.response.to.have.status(200);",
                                    "  const response = pm.response.json();",
                                    "  pm.expect(response.data).to.have.property('operation', 'deleted');",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
