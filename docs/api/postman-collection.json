{
    "info": {
        "name": "CollabOps Git Executor - Server-side Git REST API",
        "description": "Comprehensive collection for testing all server-side Git REST API endpoints. Includes examples for file operations, branch management, repository state queries, and merge operations.",
        "version": "1.0.0",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8080",
            "type": "string",
            "description": "Base URL for the Git Executor API"
        },
        {
            "key": "owner",
            "value": "testowner",
            "type": "string",
            "description": "Repository owner"
        },
        {
            "key": "repo",
            "value": "testrepo",
            "type": "string",
            "description": "Repository name"
        },
        {
            "key": "userID",
            "value": "testuser",
            "type": "string",
            "description": "User ID for authentication"
        },
        {
            "key": "source",
            "value": "orchestrator",
            "type": "string",
            "description": "Source system identifier"
        }
    ],
    "auth": {
        "type": "noauth"
    },
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "exec": [
                    "// Set default headers for all requests",
                    "pm.request.headers.add({",
                    "  key: 'X-USER-ID',",
                    "  value: pm.variables.get('userID')",
                    "});",
                    "",
                    "pm.request.headers.add({",
                    "  key: 'X-Source',",
                    "  value: pm.variables.get('source')",
                    "});",
                    "",
                    "// Set Content-Type for POST/PUT requests",
                    "if (['POST', 'PUT', 'PATCH'].includes(pm.request.method)) {",
                    "  pm.request.headers.add({",
                    "    key: 'Content-Type',",
                    "    value: 'application/json'",
                    "  });",
                    "}"
                ],
                "type": "text/javascript"
            }
        },
        {
            "listen": "test",
            "script": {
                "exec": [
                    "// Common tests for all requests",
                    "pm.test('Response time is reasonable', function () {",
                    "  pm.expect(pm.response.responseTime).to.be.below(5000);",
                    "});",
                    "",
                    "pm.test('Response has proper content type', function () {",
                    "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                    "});",
                    "",
                    "if (pm.response.code === 200) {",
                    "  pm.test('Success response has correct structure', function () {",
                    "    const response = pm.response.json();",
                    "    pm.expect(response).to.have.property('status', 'success');",
                    "    pm.expect(response).to.have.property('data');",
                    "    pm.expect(response).to.have.property('meta');",
                    "    pm.expect(response.meta).to.have.property('request_id');",
                    "    pm.expect(response.meta).to.have.property('timestamp');",
                    "  });",
                    "} else {",
                    "  pm.test('Error response has correct structure', function () {",
                    "    const response = pm.response.json();",
                    "    pm.expect(response).to.have.property('status', 'error');",
                    "    pm.expect(response).to.have.property('error');",
                    "    pm.expect(response.error).to.have.property('code');",
                    "    pm.expect(response.error).to.have.property('message');",
                    "  });",
                    "}"
                ],
                "type": "text/javascript"
            }
        }
    ],
    "item": [
        {
            "name": "File Operations",
            "description": "Single file create, update, and delete operations",
            "item": [
                {
                    "name": "Create File",
                    "request": {
                        "method": "PUT",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"content\": \"SGVsbG8gV29ybGQ=\",\n  \"commit_message\": \"Add hello.txt\",\n  \"branch\": \"main\",\n  \"author\": {\n    \"name\": \"Test User\",\n    \"email\": \"test@example.com\"\n  }\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/repos/{{owner}}/{{repo}}/files/hello.txt",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "repos",
                                "{{owner}}",
                                "{{repo}}",
                                "files",
                                "hello.txt"
                            ]
                        },
                        "description": "Creates a new file with base64-encoded content. Content: 'Hello World' encoded as base64."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('File created successfully', function () {",
                                    "  pm.response.to.have.status(200);",
                                    "  const response = pm.response.json();",
                                    "  pm.expect(response.data).to.have.property('commit_sha');",
                                    "  pm.expect(response.data).to.have.property('file_path', 'hello.txt');",
                                    "  pm.expect(response.data).to.have.property('operation', 'created');",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Update File",
                    "request": {
                        "method": "PUT",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"content\": \"SGVsbG8gVXBkYXRlZCBXb3JsZA==\",\n  \"commit_message\": \"Update hello.txt content\",\n  \"branch\": \"main\",\n  \"author\": {\n    \"name\": \"Test User\",\n    \"email\": \"test@example.com\"\n  }\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
