            ]
        },
        {
            "name": "Multi-file Operations",
            "description": "Atomic multi-file commit operations",
            "item": [
                {
                    "name": "Multi-file Commit",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"base_branch\": \"main\",\n  \"operations\": [\n    {\n      \"operation\": \"create\",\n      \"path\": \"src/main.js\",\n      \"content\": \"Y29uc29sZS5sb2coJ0hlbGxvIFdvcmxkJyk7\"\n    },\n    {\n      \"operation\": \"create\",\n      \"path\": \"src/style.css\",\n      \"content\": \"Ym9keSB7IGJhY2tncm91bmQ6ICNmMGYwZjA7IH0=\"\n    },\n    {\n      \"operation\": \"create\",\n      \"path\": \"package.json\",\n      \"content\": \"eyAibmFtZSI6ICJ0ZXN0LXByb2plY3QiIH0=\"\n    }\n  ],\n  \"commit_message\": \"Add initial project files\",\n  \"author\": {\n    \"name\": \"Test User\",\n    \"email\": \"test@example.com\"\n  }\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/repos/{{owner}}/{{repo}}/commits",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "repos",
                                "{{owner}}",
                                "{{repo}}",
                                "commits"
                            ]
                        },
                        "description": "Creates multiple files in a single atomic commit. Includes JavaScript, CSS, and JSON files."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Multi-file commit created successfully', function () {",
                                    "  pm.response.to.have.status(200);",
                                    "  const response = pm.response.json();",
                                    "  pm.expect(response.data).to.have.property('commit_sha');",
                                    "  pm.expect(response.data).to.have.property('operations_count', 3);",
                                    "  pm.expect(response.data).to.have.property('results');",
                                    "  pm.expect(response.data.results).to.be.an('array').that.has.lengthOf(3);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                }
            ]
        },
