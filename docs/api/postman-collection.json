                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"commit_message\": \"Delete hello.txt\",\n  \"branch\": \"main\",\n  \"author\": {\n    \"name\": \"Test User\",\n    \"email\": \"test@example.com\"\n  }\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/repos/{{owner}}/{{repo}}/files/hello.txt",
                            "host": [
                                "{{baseUrl}}"
