            "name": "Error Handling Tests",
            "description": "Tests for error conditions and edge cases",
            "item": [
                {
                    "name": "Unauthorized - Missing Headers",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/repos/{{owner}}/{{repo}}/state",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "repos",
                                "{{owner}}",
                                "{{repo}}",
                                "state"
                            ]
                        },
                        "description": "Test unauthorized access when headers are missing."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "exec": [
                                    "// Override global pre-request to remove headers for this test",
                                    "pm.request.headers.clear();"
                                ],
                                "type": "text/javascript"
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Returns unauthorized when headers missing', function () {",
                                    "  pm.response.to.have.status(401);",
                                    "  const response = pm.response.json();",
                                    "  pm.expect(response.error.code).to.include('unauthorized');",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Not Found - Nonexistent Repository",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/repos/{{owner}}/nonexistent/state",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "repos",
                                "{{owner}}",
                                "nonexistent",
                                "state"
                            ]
                        },
                        "description": "Test accessing a repository that doesn't exist."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Returns not found for nonexistent repository', function () {",
                                    "  pm.response.to.have.status(404);",
                                    "  const response = pm.response.json();",
                                    "  pm.expect(response.error.code).to.include('not_found');",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                },
                {
                    "name": "Bad Request - Invalid Branch Name",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"invalid..branch\",\n  \"source\": \"main\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{baseUrl}}/repos/{{owner}}/{{repo}}/branches",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "repos",
                                "{{owner}}",
                                "{{repo}}",
                                "branches"
                            ]
                        },
                        "description": "Test creating a branch with an invalid name."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Returns bad request for invalid branch name', function () {",
                                    "  pm.response.to.have.status(400);",
                                    "  const response = pm.response.json();",
                                    "  pm.expect(response.error.code).to.include('validation');",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
