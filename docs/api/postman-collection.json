                            "path": [
                                "repos",
                                "{{owner}}",
                                "{{repo}}",
                                "branches",
                                "main"
                            ]
                        },
                        "description": "Updates a branch to point to a different commit. Only fast-forward updates allowed unless force=true."
                    },
                    "response": [],
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test('Branch update response is valid', function () {",
